{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "padding": {
      "top": 0,
      "left": 0,
      "right": 8
    },
    "preserveAspectRatio": false,
    "recache": false,
    "position": "left",
    "chafa": {
      "fgOnly": false,
      "symbols": "block+border+space-wide-inverted"
    }
  },
  "modules": [
    {
      "type": "title",
      "key": "{icon} ",
      "keyIcon": "",
      "fqdn": false,
      "color": {
        "user": "",
        "at": "",
        "host": ""
      }
    },
    {
      "type": "separator",
      "string": "-",
      "outputColor": "",
      "times": 27
    },
    {
      "type": "host",
      "keyIcon": "󰇅",
      "key": "╭{icon} Workstation"
    },
    {
      "type": "cpu",
      "keyIcon": "",
      "key": "│ ├─{icon}",
      "temp": false,
      "showPeCoreCount": true
    },
    // "cpucache",
    {
      "type": "gpu",
      "key": "│ ├─{icon}",
      "keyIcon": "󰾲",
      "driverSpecific": true,
      "detectionMethod": "pci",
      "temp": false,
      "hideType": "none",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },
    {
      "type": "memory",
      "keyIcon": "󰑭",
      "key": "│ ├─{icon}",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },
    // "physicalmemory",
    // {
    //   "type": "swap",
    //   "key": "│ ├─{icon}",
    //   "percent": {
    //     "green": 50,
    //     "yellow": 80,
    //     "type": 0
    //   },
    //   "keyIcon": "󰓡",
    //   "separate": false
    // },
    {
      "type": "disk",
      "key": "│ ├─{icon}",
      "keyIcon": "",
      "showRegular": true,
      "showExternal": true,
      "showHidden": false,
      "showSubvolumes": false,
      "showReadOnly": true,
      "showUnknown": false,
      "folders": "",
      "hideFolders": "/efi:/boot:/boot/*",
      "hideFS": "",
      "useAvailable": false,
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },
    {
      "type": "battery",
      "temp": true,
      "key": "│ └─{icon}",
      "keyIcon": ""
    },
    // "poweradapter",
    // "bluetooth",
    // "mouse",
    // "keyboard",
    // {
    //   "type": "wifi",
    //   "key": "├─",
    //   "format": "{ssid}",
    //   "keyColor": "blue"
    // },
    {
      "type": "os",
      "key": "├{icon} OS",
      "keyIcon": ""
    },
    {
      "type": "kernel",
      "key": "│ ├─{icon}",
      "keyIcon": "",
      "format": "{release}"
    },
    // {
    //   "type": "packages",
    //   "key": "│ ├─{icon}",
    //   "keyIcon": "󰏖",
    //   "disabled": ["winget"],
    //   "combined": false
    // },
    // "editor",
    {
      "type": "de",
      "keyIcon": "",
      "key": "│ ├─{icon}",
      "slowVersionDetection": false
    },
    // {
    //   "type": "lm",
    //   "key": "│ ├─{icon}",
    //   "keyIcon": "󰧨",
    //   "keyColor": "blue"
    // },
    // {
    //   "type": "wm",
    //   "keyIcon": "",
    //   "key": "│ ├─{icon}",
    //   "detectPlugin": false
    // },
    // {
    //   "type": "wmtheme",
    //   "keyIcon": "󰓸"
    // },
    // {
    //   "type": "theme",
    //   "keyIcon": "󰉼"
    // },
    // {
    //   "type": "icons",
    //   "key": "│ ├󰀻",
    //   "keyColor": "blue"
    // },
    // {
    //   "type": "wallpaper",
    //   "key": "│ └󰸉",
    //   "keyColor": "blue"
    // },
    // {
    //   "type": "display",
    //   "key": "│ ├─{icon}",
    //   "keyIcon": "󰍹",
    //   "compactType": "original"
    // },
    {
      "type": "locale",
      "key": "│ ├─{icon}",
      "keyIcon": ""
    },
    // {
    //   "type": "brightness",
    //   "key": "├─󰃞",
    //   "keyColor": "green"
    // },
        {
      "type": "uptime",
      "key": "│ └─{icon}",
      "keyIcon": ""
    },
    {
      "type": "terminal",
      "key": "├{icon} Terminal",
      "keyIcon": ""
    },
    {
      "type": "terminalfont",
      "keyIcon": "",
      "key": "│ ├─{icon}"
    },
    {"type": "terminalsize", "keyIcon": "󰲏", "key": "│ ├─{icon}"},
    {"type": "terminaltheme", "keyIcon": "󰔎", "key": "│ └─{icon}"},
    // {
    //   "type": "shell",
    //   "key": "│ └─{icon}",
    //   "keyIcon": ""
    // },
    // {
    //   "key": "├󰩠 Network",
    //   "type": "publicip",
    //   "keyColor": "blue",
    //   "timeout": 1000
    // },
    // {
    //   "type": "localip",
    //   "key": "│ ├─󰩟",
    //   "compact": true,
    //   "keyColor": "blue"
    // },
    // {"type": "dns", "key": "│ └─󰇖"},
    {"type": "version", "key": "╰ Version"}
  ]
}

